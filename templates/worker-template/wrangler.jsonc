{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "d1-rest-worker-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-19",
  "d1_databases": [
    {
      "binding": "DB",
      // Replace with your real D1 database id from `wrangler d1 create`.
      "database_id": "REPLACE_ME",
    },
  ],
  "vars": {
    "CORS_ORIGINS": "*",
    "RESOURCE_CONFIG": "{}",
  },
  // Uncomment to enable rate limiting (needs Wrangler >= 4.36):
  // "ratelimits": [
  //   { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
  // ],
}
